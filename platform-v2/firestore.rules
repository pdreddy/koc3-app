rules_version = '2';

// Tournament isolation model: every read/write below is scoped to a single
// tournaments/{tournamentId} subtree, and role is resolved by reading a permissions
// document stored IN that same subtree (tournaments/{tournamentId}/permissions/{uid})
// rather than relying on Firebase Auth custom claims. This sidesteps a real bug found
// while building the koc3-app multi-club PR: RTDB rules there gated writes on custom
// claims that nothing in that codebase ever set, silently breaking admin/write flows.
// Reading a same-request Firestore document instead needs no separate claims-issuing
// Cloud Function and can't drift out of sync with reality the same way.
//
// Tournaments live directly at the top level (no "platform/" namespace prefix) because
// Firestore document paths must strictly alternate collection/document/collection/document
// — "platform/tournaments" would be 2 segments (collection "platform", DOCUMENT
// "tournaments"), not a namespaced collection, which broke every query at runtime
// ("Invalid collection reference... must have an odd number of segments"). See
// src/services/firestorePaths.ts.
//
// STATUS: skeleton, not deployed or tested against a real project — see
// platform-v2/README.md / memory/MULTI_CLUB_SAAS_PLAN.md follow-up notes.
// SUPER_ADMIN (platform-wide, can manage any tournament) is backed by a top-level
// superAdmins/{uid} allowlist collection — see isSuperAdmin() and the superAdmins /
// superAdminInvites match blocks below.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Platform-wide super admin: presence of a top-level superAdmins/{uid} doc (see
    // src/services/superAdminService.ts, src/contexts/SuperAdminContext.tsx). Every
    // per-tournament role function below (hasRole/isTournamentAdmin/isCaptainOfTeam) ORs
    // against this, so a super admin transparently gets admin access to every tournament
    // without needing a permissions/{uid} doc in each one.
    function isSuperAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/superAdmins/$(request.auth.uid));
    }

    // The only way the very first super admin can ever come into existence: a hardcoded
    // allowlist, since every OTHER create path on superAdmins/{uid} requires isSuperAdmin()
    // to already be true. Mirror of BOOTSTRAP_SUPER_ADMIN_EMAILS in superAdminService.ts —
    // keep both lists in sync by hand.
    function isBootstrapSuperAdminEmail(email) {
      return email in ['damu.palavali@gmail.com'];
    }

    function permissionDoc(tournamentId) {
      return get(/databases/$(database)/documents/tournaments/$(tournamentId)/permissions/$(request.auth.uid));
    }

    function hasRole(tournamentId, roles) {
      return isSignedIn() && (
        isSuperAdmin() ||
        (permissionDoc(tournamentId).data.role in roles)
      );
    }

    function isTournamentAdmin(tournamentId) {
      return hasRole(tournamentId, ['TOURNAMENT_ADMIN', 'ORGANIZER']);
    }

    function isCaptainOfTeam(tournamentId, teamId) {
      return isSignedIn() && (
        isSuperAdmin() ||
        (permissionDoc(tournamentId).data.role in ['CAPTAIN', 'VICE_CAPTAIN'] &&
         permissionDoc(tournamentId).data.teamId == teamId)
      );
    }

    // Notifications are a broadcast board (one doc, many recipients), not a personal inbox
    // — see types/notification.ts for why there's no per-recipient fan-out or read field.
    function hasAnyRole(tournamentId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/tournaments/$(tournamentId)/permissions/$(request.auth.uid));
    }

    function canReadNotification(tournamentId, audience) {
      return isSuperAdmin() ||
        (audience == 'ALL' && hasAnyRole(tournamentId)) ||
        (audience == 'ADMIN' && isTournamentAdmin(tournamentId)) ||
        (hasAnyRole(tournamentId) && audience == 'TEAM_' + permissionDoc(tournamentId).data.teamId);
    }

    // Blind-lineup reveal, with no Cloud Function: a lineup doc (id ==
    // `${scheduleEntryId}__${teamId}`, see types/lineup.ts lineupDocId()) is only readable
    // by the OTHER team once both teams' lineups have lockedAt set. This cross-document
    // check is exactly the kind of thing koc3-app v1 needed a Cloud Function for (RTDB
    // rules there couldn't do it); Firestore's get() makes it possible directly in rules.
    function scheduleFixture(tournamentId, scheduleEntryId) {
      return get(/databases/$(database)/documents/tournaments/$(tournamentId)/schedules/$(scheduleEntryId));
    }

    function opponentLineupLocked(tournamentId, scheduleEntryId, teamId) {
      let fixture = scheduleFixture(tournamentId, scheduleEntryId).data;
      let otherTeamId = fixture.team1Id == teamId ? fixture.team2Id : fixture.team1Id;
      let otherLineupId = scheduleEntryId + '__' + otherTeamId;
      let otherLineupPath = /databases/$(database)/documents/tournaments/$(tournamentId)/lineups/$(otherLineupId);
      return exists(otherLineupPath) && get(otherLineupPath).data.lockedAt != null;
    }

    // Platform-wide, not scoped to any tournament — see isSuperAdmin() above.
    match /superAdmins/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      // Self-write is allowed either via the hardcoded bootstrap allowlist (only ever
      // matches the founder's own email) or by claiming a matching, unclaimed
      // superAdminInvites/{email} doc — same claim-on-login shape as tournament invites.
      allow create: if isSuperAdmin() ||
        (isSignedIn() && request.auth.uid == userId && request.auth.token.email != null &&
         isBootstrapSuperAdminEmail(request.auth.token.email)) ||
        (isSignedIn() && request.auth.uid == userId && request.auth.token.email != null &&
         exists(/databases/$(database)/documents/superAdminInvites/$(request.auth.token.email)) &&
         get(/databases/$(database)/documents/superAdminInvites/$(request.auth.token.email)).data.claimedBy == null);
      allow update, delete: if isSuperAdmin();
    }

    match /superAdminInvites/{email} {
      allow read: if isSuperAdmin() || (isSignedIn() && request.auth.token.email == email);
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() ||
        (isSignedIn() &&
         request.auth.token.email == email &&
         resource.data.claimedBy == null &&
         request.resource.data.claimedBy == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy', 'claimedAt']));
    }

    match /tournaments/{tournamentId} {
      // Tournament doc itself: publicly readable once published (so /t/{slug} works for
      // guests), otherwise admin-only. Writes always admin-only.
      allow read: if resource.data.status == 'PUBLISHED' || isTournamentAdmin(tournamentId);
      allow create: if isSignedIn(); // any signed-in user can create a tournament (becomes its admin via the permissions doc created alongside it)
      allow update, delete: if isTournamentAdmin(tournamentId);

      match /permissions/{userId} {
        // Users can read their own role; admins can read/write everyone's.
        allow read: if isSignedIn() && (request.auth.uid == userId || isTournamentAdmin(tournamentId));
        // Bootstrap exception: the tournament's creator may grant *themselves*
        // TOURNAMENT_ADMIN exactly once (checked against the tournament doc's createdBy,
        // not against any existing permission doc — the whole point is that none exists
        // yet). Without this, isTournamentAdmin() could never become true for a brand new
        // tournament, since permission docs are the only thing it checks. See
        // TournamentService.create(), which performs this write immediately after creating
        // the tournament doc.
        // Second self-write exception: a signed-in user may create their OWN permission
        // doc if it exactly matches an unclaimed invite for their email
        // (tournaments/{tournamentId}/invites/{email}, doc id == email). This is what lets
        // an admin-issued invite ("captain@example.com is CAPTAIN of Team 3") turn into a
        // real role the moment that person signs in — see
        // hooks/useClaimPendingInvite.ts, which performs this write. CAVEAT: compares
        // request.auth.token.email directly as a path segment; not verified against a real
        // deploy that this always matches the invite doc id's casing — see README.md.
        allow create: if isTournamentAdmin(tournamentId) ||
          (isSignedIn() &&
           request.auth.uid == userId &&
           request.auth.uid == get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.createdBy &&
           request.resource.data.role == 'TOURNAMENT_ADMIN') ||
          (isSignedIn() &&
           request.auth.uid == userId &&
           request.auth.token.email != null &&
           exists(/databases/$(database)/documents/tournaments/$(tournamentId)/invites/$(request.auth.token.email)) &&
           get(/databases/$(database)/documents/tournaments/$(tournamentId)/invites/$(request.auth.token.email)).data.claimedBy == null &&
           get(/databases/$(database)/documents/tournaments/$(tournamentId)/invites/$(request.auth.token.email)).data.role == request.resource.data.role &&
           get(/databases/$(database)/documents/tournaments/$(tournamentId)/invites/$(request.auth.token.email)).data.teamId == request.resource.data.teamId);
        allow update, delete: if isTournamentAdmin(tournamentId);
      }

      match /invites/{email} {
        // An admin can see/manage every invite; the invited person can see their own (to
        // know they've been invited) before they've even signed up.
        allow read: if isTournamentAdmin(tournamentId) || (isSignedIn() && request.auth.token.email == email);
        allow create, delete: if isTournamentAdmin(tournamentId);
        // Claiming: the invited user may flip claimedBy from null to their own uid — and
        // only that, nothing else about the invite — once. Everything else (re-assigning
        // an invite, changing its role) stays admin-only.
        allow update: if isTournamentAdmin(tournamentId) ||
          (isSignedIn() &&
           request.auth.token.email == email &&
           resource.data.claimedBy == null &&
           request.resource.data.claimedBy == request.auth.uid &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy', 'claimedAt']));
      }

      match /teams/{teamId} {
        allow read: if true; // teams are public once the tournament is published — visibility.teams config still gates the UI
        allow write: if isTournamentAdmin(tournamentId);
      }

      match /players/{playerId} {
        allow read: if true;
        allow write: if isTournamentAdmin(tournamentId);
      }

      match /announcements/{announcementId} {
        allow read: if true;
        allow write: if isTournamentAdmin(tournamentId);
      }

      match /sponsors/{sponsorId} {
        allow read: if true;
        allow write: if isTournamentAdmin(tournamentId);
      }

      match /gallery/{imageId} {
        allow read: if true;
        allow write: if isTournamentAdmin(tournamentId);
      }

      match /schedules/{scheduleId} {
        allow read: if true;
        allow create, delete: if isTournamentAdmin(tournamentId); // schedule generation is admin-only
        // A captain of either scheduled team may mark their own entry as played once they
        // submit a score (ScoreEntry.tsx sets status + matchId together with the Match
        // create) — everything else about the schedule (dates/times/teams) stays admin-only.
        allow update: if isTournamentAdmin(tournamentId) ||
          ((isCaptainOfTeam(tournamentId, resource.data.team1Id) || isCaptainOfTeam(tournamentId, resource.data.team2Id)) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'matchId']));
      }

      match /playoffMatches/{playoffMatchId} {
        allow read: if true;
        // Bracket generation (GeneratePlayoffs.tsx) and advancement (advancePlayoffWinner,
        // called from ApproveScores.tsx / an admin's own ScoreEntry.tsx submission) are
        // both always admin-actor operations — admins may write anything. The one
        // exception: a captain submitting a score for their own ready bracket slot
        // (ScoreEntry.tsx, non-admin path) just links matchId so the slot drops out of the
        // "ready" list while pending; they can never touch team1Id/team2Id/winnerTeamId/
        // the forward-advancement fields themselves.
        allow create, delete: if isTournamentAdmin(tournamentId);
        allow update: if isTournamentAdmin(tournamentId) ||
          ((isCaptainOfTeam(tournamentId, resource.data.team1Id) || isCaptainOfTeam(tournamentId, resource.data.team2Id)) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['matchId']));
      }

      match /standings/{teamId} {
        allow read: if true;
        allow write: if isTournamentAdmin(tournamentId); // standings are server/admin-computed, not player-writable
      }

      match /matches/{matchId} {
        allow read: if true;
        // A captain may create a match their own team is part of, but only as
        // PENDING_APPROVAL — an admin-entered match may go straight to APPROVED (matches
        // ScoreEntry.tsx's isAdminEntry check). Only an admin may ever set status to
        // APPROVED: a captain can keep editing their own match while it's still
        // PENDING_APPROVAL (request.resource.data.status must also stay PENDING_APPROVAL),
        // but cannot self-approve. See pages/admin/ApproveScores.tsx.
        allow create: if isTournamentAdmin(tournamentId) ||
          ((request.resource.data.status == 'PENDING_APPROVAL') &&
           (isCaptainOfTeam(tournamentId, request.resource.data.team1Id) || isCaptainOfTeam(tournamentId, request.resource.data.team2Id)));
        allow update: if isTournamentAdmin(tournamentId) ||
          ((resource.data.status == 'PENDING_APPROVAL') &&
           (request.resource.data.status == 'PENDING_APPROVAL') &&
           (isCaptainOfTeam(tournamentId, resource.data.team1Id) || isCaptainOfTeam(tournamentId, resource.data.team2Id)));
        allow delete: if isTournamentAdmin(tournamentId);
      }

      match /lineups/{lineupId} {
        // Own team's lineup: always readable by that team's captain (and admins). The
        // opponent's lineup: only once both are locked (opponentLineupLocked) — this is the
        // actual "reveal" mechanism, not a separate revealedLineups collection.
        // Reveal is intentionally public (no isSignedIn() check) once both teams have
        // locked — matches koc3-app's Schedule.js, which shows revealed lineups to any
        // visitor, not just signed-in ones. This only ever exposes lineups BOTH captains
        // already committed to; nothing pending/partial leaks.
        allow read: if isTournamentAdmin(tournamentId) ||
          (isSignedIn() && isCaptainOfTeam(tournamentId, resource.data.teamId)) ||
          (resource.data.lockedAt != null &&
           opponentLineupLocked(tournamentId, resource.data.scheduleEntryId, resource.data.teamId));
        allow create: if isTournamentAdmin(tournamentId) ||
          isCaptainOfTeam(tournamentId, request.resource.data.teamId);
        // Editable freely (draft saves) until locked; once lockedAt is set, immutable
        // except by an admin — matches ScoreEntry's already-APPROVED-is-final convention.
        allow update: if isTournamentAdmin(tournamentId) ||
          (isCaptainOfTeam(tournamentId, resource.data.teamId) && resource.data.lockedAt == null);
        allow delete: if isTournamentAdmin(tournamentId);
      }

      match /auditLogs/{logId} {
        // Read: admin-only (this is the whole point of an audit trail). Create: any
        // signed-in user may write an entry recording THEIR OWN action (performedByUserId
        // must match the caller) — services/auditService.ts is the only writer, called from
        // score entry, lineup locking, role invites/claims, and tournament-level actions.
        // Immutable once written: no update, and delete is admin-only (e.g. to prune).
        allow read: if isTournamentAdmin(tournamentId);
        allow create: if isSignedIn() && request.resource.data.performedByUserId == request.auth.uid;
        allow update: if false;
        allow delete: if isTournamentAdmin(tournamentId);
      }

      match /notifications/{notificationId} {
        allow read: if canReadNotification(tournamentId, resource.data.audience);
        // Self-attributed writer, same convention as auditLogs above: any signed-in
        // tournament participant may post one (e.g. a captain's ScoreEntry.tsx submission
        // notifying admins it needs approval) — nothing sensitive lives here, so misuse is
        // just noise, not a security hole.
        allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
        allow update: if false;
        allow delete: if isTournamentAdmin(tournamentId);
      }
    }
  }
}
